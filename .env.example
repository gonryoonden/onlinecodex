# Copy to apps/studio/.env.local; NEVER use NEXT_PUBLIC_ for keys.
GEMINI_API_KEY=
# Optional pin; empty selects the first accessible documented candidate.
GEMINI_VISION_MODEL=
# Set free ONLY after checking this API key's project Billing Tier in AI Studio.
# This is operator confirmation; it does not enforce Google's billing.
GEMINI_BILLING_TIER=
# interactions (default) or generate-content (explicit compatibility option)
GEMINI_API_MODE=interactions
ENABLE_PAID_AI=false
AI_DAILY_LIMIT=20
STUDIO_PYTHON=python3
# Optional PRIVATE reverse-proxy token. Sent as Authorization: Bearer by a trusted gateway.
# STUDIO_ACCESS_TOKEN=

# 429일 때만 다음 공식 무료 후보로 전환 (각 후보 1회, 유료 모델 제외)
GEMINI_QUOTA_FALLBACK=true
