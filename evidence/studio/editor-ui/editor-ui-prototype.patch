+export type Bounds={x:number;y:number;width:number;height:number};
+export function selectionBounds(elements:AnyElement[]):Bounds|undefined{
+ const corners=elements.filter(e=>e.visible).flatMap(e=>{const a=e.rotation*Math.PI/180,c=Math.cos(a),s=Math.sin(a);return [[0,0],[e.width,0],[e.width,e.height],[0,e.height]].map(([x,y])=>({x:e.x+x*c-y*s,y:e.y+x*s+y*c}));});
