+}
+export function viewScale(mode:'fit'|'width'|'manual'|'selection',viewport:Bounds,document:Bounds,manual:number,target?:Bounds){
+ const available={width:Math.max(1,viewport.width-32),height:Math.max(1,viewport.height-32)},b=mode==='selection'&&target?target:document;
+ return Math.max(.01,Math.min(8,mode==='manual'?manual:mode==='width'?available.width/b.width:Math.min(available.width/b.width,available.height/b.height)));
+}
